{
  "name": "tiny-sphere",
  "version": "1.2.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SonicSphere/TinySphere.git"
  },
  "homepage": "https://sonicsphere.github.io/TinySphere/",
  "bugs": "https://github.com/SonicSphere/TinySphere/issues",
  "description": "A 3D light and sound simulator for the Sonic Sphere at Burning Man.",
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build.py",
    "start": "python3 scripts/serve.py",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm run build && npm test && node scripts/check-release.mjs",
    "new:show": "node scripts/new-content.mjs show",
    "new:theme": "node scripts/new-content.mjs theme",
    "package:source": "python3 scripts/package-source.py"
  },
  "engines": {
    "node": ">=22"
  }
}
